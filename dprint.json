{
  "lineWidth": 100,
  "indentWidth": 2,
  "newLineKind": "lf",
  "typescript": {
    "semiColons": "always"
  },
  "json": {},
  "markdown": {
    "textWrap": "maintain"
  },
  "toml": {},
  "yaml": {},
  "markup": {},
  "malva": {},
  "includes": [
    "**/*.{ts,tsx,json,md,toml,yml,yaml,html,css}"
  ],
  "excludes": [
    "**/node_modules",
    "**/dist",
    "**/.cache",
    "**/coverage",
    ".agents/**",
    ".git/**",
    "bun.lock",
    "tests/fixtures/documents/**"
  ],
  "plugins": [
    "https://plugins.dprint.dev/typescript-0.96.1.wasm",
    "https://plugins.dprint.dev/json-0.23.0.wasm",
    "https://plugins.dprint.dev/markdown-0.23.3.wasm",
    "https://plugins.dprint.dev/toml-0.8.0.wasm",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm",
    "https://plugins.dprint.dev/g-plane/markup_fmt-v0.27.3.wasm",
    "https://plugins.dprint.dev/g-plane/malva-v0.16.0.wasm"
  ]
}
